---
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.svelte';
import CodeCopy from '../components/CodeCopy.svelte';
import favicon from '../assets/viva-mark.svg?url';
import appleTouchIcon from '../assets/apple-touch-icon.png?url';
import markOnly from '../assets/viva-mark-only.svg?url';
import BrandLockup from '../components/BrandLockup.astro';
import SearchDialog from '../components/SearchDialog.svelte';
import '../styles/global.css';
import { locales, languageNames, defaultLocale, componentsPath, type Locale } from '../lib/i18n';
import { siteText } from '../lib/site';
import { homePath, docsPath, apiPath, showcasePath, type Section } from '../lib/routes';

interface Props {
  title: string;
  summary: string;
  locale: Locale;
  section: Section;
  // The same page in every language, so the language switch keeps the reader here.
  alternates: Record<Locale, string>;
  // The page's own schema.org nodes. The layout adds the Organization and
  // WebSite that every page carries, so a page only describes itself.
  schema?: Record<string, unknown>[];
}

const { title, summary, locale, section, alternates, schema = [] } = Astro.props;
const text = siteText(locale);
const navigation = [
  { section: 'docs', href: docsPath(locale), label: text.navDocs },
  { section: 'components', href: componentsPath(locale), label: text.navComponents },
  { section: 'showcase', href: showcasePath(locale), label: text.navShowcase },
  { section: 'api', href: apiPath(locale), label: text.navApi },
] as const;

// Search engines and assistants read whole pages, never a language switch: the
// canonical names this language's URL, and every alternate names its own.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternateURLs = Object.fromEntries(locales.map(language => [language, new URL(alternates[language], Astro.site).href])) as Record<Locale, string>;
const pageTitle = section === 'home' ? title : `${title} · Viva`;
const origin = Astro.site!.href.replace(/\/$/, '');
// One graph per page, so an assistant that reads a single page still learns what
// the product is, where it lives and which page it is looking at.
const graph = [
  {
    '@type': 'Organization',
    '@id': `${origin}/#organization`,
    name: 'Viva',
    url: `${origin}/`,
    logo: { '@type': 'ImageObject', url: new URL(appleTouchIcon, Astro.site).href },
    description: 'Viva is an open-source, Go-native desktop application framework and runtime, maintained in the vivaui/viva repository.',
    sameAs: ['https://github.com/vivaui/viva', 'https://pkg.go.dev/github.com/vivaui/viva'],
  },
  {
    '@type': 'WebSite',
    '@id': `${origin}/#website`,
    name: 'Viva',
    url: `${origin}/`,
    inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
    publisher: { '@id': `${origin}/#organization` },
  },
  ...schema,
];
const structuredData = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
// Cloudflare's Email Address Obfuscation rewrites anything that looks like an
// address, and `go get github.com/vivaui/viva@v0.1.3` was being served to
// readers and crawlers as `github.com/vivaui/[email protected]`. The documented
// <!--email_off--> marker switches it off for this document while the zone
// setting stays on, and it survives someone toggling that setting again.
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <ClientRouter />
    {locales.map(language => <link rel="alternate" hreflang={language === 'zh' ? 'zh-CN' : 'en'} href={alternateURLs[language]} />)}
    <link rel="alternate" hreflang="x-default" href={alternateURLs[defaultLocale]} />
    <meta property="og:type" content={section === 'home' ? 'website' : 'article'} />
    <meta property="og:site_name" content="Viva" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    {locales.filter(language => language !== locale).map(language => <meta property="og:locale:alternate" content={language === 'zh' ? 'zh_CN' : 'en_US'} />)}
    <meta property="og:image" content={new URL(appleTouchIcon, Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={new URL(appleTouchIcon, Astro.site).href} />
    <script type="application/ld+json" is:inline set:html={structuredData}></script>
    <script is:inline>
      // The client router swaps the document, which restores the markup's
      // data-theme="light" and drops the reader's choice. Reapply it before the
      // new page paints, both on first load and after every client navigation.
      // The function wrapper keeps a re-inserted copy of this script from
      // redeclaring its names.
      (() => {
        const applyStoredTheme = () => {
          try {
            const theme = localStorage.getItem('viva-docs-theme') === 'dark' ? 'dark' : 'light';
            document.documentElement.dataset.theme = theme;
            document.documentElement.style.colorScheme = theme;
          } catch {}
        };
        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);
      })();
    </script>
  </head>
  <body>
    <Fragment set:html="<!--email_off-->" />
    <a class="skip-link" href="#main-content">{text.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={homePath(locale)} aria-label={text.home}><BrandLockup /></a>
        <nav class="header-navigation" aria-label={text.primaryNavigation}>{navigation.map(entry => <a href={entry.href} aria-current={section === entry.section ? 'page' : undefined}>{entry.label}</a>)}</nav>
        <div class="header-end"><SearchDialog {locale} labels={{ label: text.search, placeholder: text.searchPlaceholder, empty: text.searchEmpty, components: text.navComponents, guides: text.navDocs, api: text.navApi }} client:load /><a class="repository-link" href="https://github.com/vivaui/viva" target="_blank" rel="noopener noreferrer" aria-label={text.repository} title={text.repository}><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.35 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"/></svg></a><nav class="language-switch" aria-label={text.language}>{locales.map(language => <a href={alternates[language]} lang={language === 'zh' ? 'zh-CN' : 'en'} hreflang={language === 'zh' ? 'zh-CN' : 'en'} aria-current={language === locale ? 'page' : undefined} aria-label={languageNames[language]}>{language === 'zh' ? '中文' : 'EN'}</a>)}</nav><ThemeToggle {locale} client:load /></div>
      </div>
    </header>
    <slot />
    <CodeCopy {locale} client:load />
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <span class="footer-wordmark"><img src={markOnly} alt="" aria-hidden="true" />viva</span>
          <p>{text.footerTagline}</p>
        </div>
        <nav class="footer-column" aria-label={text.navDocs}>
          <h2>{text.navDocs}</h2>
          <ul>
            <li><a href={docsPath(locale, 'getting-started')}>{text.footerStart}</a></li>
            <li><a href={componentsPath(locale)}>{text.footerCatalog}</a></li>
            <li><a href={docsPath(locale)}>{text.footerGuides}</a></li>
            <li><a href={apiPath(locale)}>{text.footerApi}</a></li>
          </ul>
        </nav>
        <nav class="footer-column" aria-label={text.footerResources}>
          <h2>{text.footerResources}</h2>
          <ul>
            <li><a href="https://github.com/vivaui/viva" target="_blank" rel="noopener noreferrer">{text.footerRepo}</a></li>
            <li><a href={docsPath(locale, 'coding-agents')}>{text.footerAgents}</a></li>
            <li><a href={docsPath(locale, 'platforms')}>{text.footerPlatforms}</a></li>
            <li><a href="https://github.com/vivaui/viva/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">{text.footerLicense}</a></li>
          </ul>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Viva</span>
        <span>{text.footerBuilt}</span>
      </div>
    </footer>
    <Fragment set:html="<!--/email_off-->" />
  </body>
</html>
